# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/stopee

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Sessions
SESSION_SECRET=change-me-to-a-long-random-string

# App (PORT fija el puerto del servidor de desarrollo; APP_URL debe coincidir)
PORT=4827
APP_URL=http://localhost:4827

# Archivos subidos desde el backoffice (imágenes, videos, PDF).
# Vacío = se guardan en public/uploads (desarrollo local).
# En producción (Google Cloud Run) pon el nombre del bucket de Cloud Storage.
GCS_BUCKET=

# Correo transaccional con Brevo (https://app.brevo.com). Sin estas dos variables
# el sitio funciona igual, pero no envía correos (solo deja un aviso en el log).
BREVO_API_KEY=
# Remitente: debe estar verificado en Brevo (Remitentes y dominios).
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=STOPee

# Correo de respaldo al que llegan los avisos del formulario de contacto si no
# hay uno capturado en Datos del negocio. NO da permisos de administrador: para
# eso, registra la cuenta en /cuenta/registro y ejecuta
# `npm run make-admin -- tu-correo@ejemplo.com`.
ADMIN_EMAIL=
